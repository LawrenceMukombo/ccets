# Server Configuration
PORT=5050
NODE_ENV=production

# Database Configuration
# REQUIRED: You must set these values
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=png_ccets
# Optional: Set to 'true' if your database requires SSL (common for managed DBs)
# DB_SSL=true

# Security
# REQUIRED: Generate a strong random string (e.g., `openssl rand -base64 32`)
JWT_SECRET=change_this_to_a_secure_random_secret_key

# Deployment & Instance Config
# Modes: global_multi_tenant, country_multi_tenant, standalone_country
CCETS_DEPLOYMENT_MODE=global_multi_tenant
CCETS_INSTANCE_NAME="CCETS Global cold chain"
# Used in standalone mode to auto-select target country/tenant
CCETS_DEFAULT_TENANT=png
